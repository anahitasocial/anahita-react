# ---------------------------------------------------------------------
# Anahita web app — copy to .env and edit.
#
# Only PUBLIC_URL, NODE_ENV and REACT_APP_* reach the browser. Create
# React App refuses to expose anything else, so a variable without the
# prefix is read by nobody however sensible its name looks.
#
# Everything here is compiled INTO THE BUNDLE at build time, so changing
# a value needs a dev-server restart and a rebuild for production. That
# is the test for whether a setting belongs here at all: anything an
# operator should change without a rebuild belongs on the server, where
# the app reads it from NodeInfo instead.
#
# Which files CRA loads, highest priority first:
#
#   .env.${NODE_ENV}.local     NODE_ENV is development for `yarn start`
#   .env.${NODE_ENV}           and production for `yarn build`
#   .env.local                 loaded in every environment but test
#   .env
#
# Those names are the whole list. A file called .env.prod or
# .env.staging is not read by anything.
# ---------------------------------------------------------------------


# Identity ------------------------------------------------------------

# The product name, used throughout the UI and substituted into
# public/index.html as %REACT_APP_NAME%.
REACT_APP_NAME=Anahita

# The meta description, substituted as %REACT_APP_DESCRIPTION%.
REACT_APP_DESCRIPTION=Knowledge Networking Platform & Framework

# Where this app is served from.
PUBLIC_URL=http://localhost:3000


# Back end ------------------------------------------------------------

# The nginx gateway in anahita-services. Every API call is relative to
# it, so this is the one value that decides which installation the app
# talks to.
REACT_APP_API_BASE_URL=https://yourendpointurl


# Optional ------------------------------------------------------------

# Google Analytics property. UA- ids are Universal Analytics, which
# stopped processing data in 2023; a live GA4 property looks like
# G-XXXXXXXXXX.
REACT_APP_GOOGLE_ANALYTICS=

# How often to poll for new notifications, in milliseconds.
# 1500000 is 25 minutes.
REACT_APP_NOTIFICATIONS_CHECK_INTERVAL=1500000

# Theme directory under src/assets. Unset loads ./default, which is what
# supplies the left menu and the logo.
#
# Note the name: src/assets/index.js reads REACT_APP_ASSETS. An earlier
# REACT_APP_THEME in this file was read by nothing.
# REACT_APP_ASSETS=anahitapolis

# Pin every new location to one place, which hides the matching pickers
# on the location form. Unset means people choose freely — the normal
# case, and why these are commented rather than empty.
#
# Country and region are SHORT CODES, not names: the selects store
# option[1] from react-country-region-selector. City is free text.
# REACT_APP_LOCATION_FIXED_COUNTRY=CA
# REACT_APP_LOCATION_FIXED_STATE_PROVINCE=BC
# REACT_APP_LOCATION_FIXED_CITY=Vancouver


# Build ---------------------------------------------------------------

# Let the build compile with lint errors rather than refusing to.
# ESLINT_NO_DEV_ERRORS=true
# DISABLE_ESLINT_PLUGIN=true


# ---------------------------------------------------------------------
# Deliberately absent, because the server owns them now:
#
#   SUPPORT_EMAIL, SUPPORT_NAME, SUPPORT_PHONE, SUPPORT_URL
#     Never worked here — no REACT_APP_ prefix, so CRA never exposed
#     them. Support contacts are published through NodeInfo and set in
#     anahita-services as SUPPORT_EMAIL, SUPPORT_PHONE and
#     SUPPORT_WEBSITE. That is what makes changing one a restart rather
#     than a frontend rebuild.
#
#   REACT_APP_SIGNUP_CLOSED
#     Replaced by NodeInfo's openRegistrations. It was an opinion held
#     by the browser: it hid a tab while the endpoint behind it stayed
#     open to anybody who looked. See src/api/nodeInfo.js.
# ---------------------------------------------------------------------
